{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/presenter/layout,_N_T_/presenter/page,_N_T_/presenter"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/presenter/__PAGE__",
    "/presenter",
    "/_index",
    "/_head"
  ]
}